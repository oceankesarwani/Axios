<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="14dp"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp"
    style="@style/Widget.Material3.CardView.Outlined">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <TextView
            android:id="@+id/memberAvatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/avatar_bg"
            android:fontFamily="@font/playfair_display"
            android:gravity="center"
            android:textColor="@color/accent_gold"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/memberName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/playfair_display"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/btnEditMember"
            app:layout_constraintStart_toEndOf="@id/memberAvatar"
            app:layout_constraintTop_toTopOf="@id/memberAvatar" />

        <TextView
            android:id="@+id/memberRollNo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp"
            android:letterSpacing="0.05"
            app:layout_constraintEnd_toStartOf="@id/btnEditMember"
            app:layout_constraintStart_toEndOf="@id/memberAvatar"
            app:layout_constraintTop_toBottomOf="@id/memberName" />


        <ImageButton
            android:id="@+id/btnEditMember"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/edit_btn_bg"
            android:contentDescription="Edit member"
            android:padding="7dp"
            android:src="@drawable/outline_edit_24"
            android:tint="#1565C0"
            app:layout_constraintEnd_toStartOf="@id/btnDeleteMember"
            app:layout_constraintTop_toTopOf="parent" />


        <ImageButton
            android:id="@+id/btnDeleteMember"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/delete_btn_bg"
            android:contentDescription="Delete member"
            android:padding="7dp"
            android:src="@drawable/outline_delete_24"
            android:tint="@color/delete_red"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/memberDivider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:alpha="0.12"
            android:background="?attr/colorOnSurface"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/memberAvatar" />

        <TextView
            android:id="@+id/memberContactInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:drawablePadding="6dp"
            android:fontFamily="sans-serif"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/memberDivider" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>